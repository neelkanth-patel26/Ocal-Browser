{
  "name": "ocal",
  "productName": "Ocal Browser",
  "version": "9.5.00",
  "description": "Ocal Browser - Fast, Secure, and Agentic.",
  "main": "main.js",
  "author": "Gaming Network Studio Media Group",
  "scripts": {
    "start": "electron-forge start -- --app-name=\"Ocal Browser\"",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "build-exe": "electron-builder --win portable",
    "build-premium": "electron-builder --win nsis",
    "build-inno": "powershell -ExecutionPolicy Bypass -File build-dist.ps1",
    "sign-installer": "powershell -ExecutionPolicy Bypass -File scripts/sign-installer.ps1",
    "build-store": "powershell -ExecutionPolicy Bypass -File build-store.ps1"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "adm-zip": "^0.6.0",
    "border-beam": "^1.3.0",
    "cross-fetch": "^4.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "img-fx": "^0.5.1",
    "liquid-gooey": "^0.2.1",
    "qrcode": "^1.5.4",
    "thinking-orbs": "^0.3.1",
    "three": "^0.186.0",
    "voice-glow": "^0.2.0"
  },
  "build": {
    "appId": "com.ocal.browser.v2",
    "productName": "Ocal Browser",
    "copyright": "Copyright © 2026 Gaming Network Studio Media Group",
    "directories": {
      "output": "dist-builder",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist-store/**",
      "!dist-inno/**",
      "!dist-builder/**",
      "!dist/**",
      "!out/**",
      "!scratch/**",
      "!.agents/**",
      "!.git/**",
      "!.github/**",
      "!.vscode/**",
      "!*.ps1",
      "!*.bat",
      "!*.iss",
      "!*.md",
      "!*.log",
      "!release_info.json",
      "!temp_asar/**",
      "!ocal-sync-sessions.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "protocols": [
      {
        "name": "HTTP URL",
        "schemes": [
          "http"
        ]
      },
      {
        "name": "HTTPS URL",
        "schemes": [
          "https"
        ]
      },
      {
        "name": "Ocal Protocol",
        "schemes": [
          "ocal"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "description": "Hypertext Markup Language",
        "icon": "icon.ico",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "description": "Hypertext Markup Language",
        "icon": "icon.ico",
        "role": "Viewer"
      },
      {
        "ext": "shtml",
        "name": "Server Side HTML Document",
        "icon": "icon.ico",
        "role": "Viewer"
      },
      {
        "ext": "xhtml",
        "name": "XHTML Document",
        "icon": "icon.ico",
        "role": "Viewer"
      },
      {
        "ext": "svg",
        "name": "Scalable Vector Graphics",
        "icon": "icon.ico",
        "role": "Viewer"
      },
      {
        "ext": "webp",
        "name": "WebP Image",
        "icon": "icon.ico",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "Portable Document Format",
        "icon": "pdf-icon.ico",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "allowElevation": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "runAfterFinish": true,
      "shortcutName": "Ocal",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    },
    "appx": {
      "applicationId": "OcalBrowser",
      "identityName": "GamingNetworkStudioMediaGroup.OcalBrowser",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "Gaming Network Studio Media Group",
      "displayName": "Ocal Browser",
      "backgroundColor": "#0c0d12",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": true,
      "setBuildNumber": true
    }
  }
}
